{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://k-supervisor/notification-delivery-attempt/1.0",
  "title": "NotificationDeliveryAttempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["delivery_attempt_id", "notification_id", "project_id", "idempotency_key", "attempt_number", "channel", "recipient", "status", "created_at"],
  "properties": {
    "delivery_attempt_id": {"type": "string", "minLength": 1},
    "notification_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "attempt_number": {"type": "integer", "minimum": 1},
    "channel": {"const": "EMAIL"},
    "recipient": {"type": "string", "minLength": 3},
    "status": {"enum": ["PENDING", "SENT", "FAILED"]},
    "created_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "provider_message_id": {"type": ["string", "null"]},
    "error_message": {"type": ["string", "null"]}
  }
}
