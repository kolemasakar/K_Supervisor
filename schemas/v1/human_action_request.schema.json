{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://k-supervisor/human-action-request/1.0",
  "title": "HumanActionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["human_action_id", "project_id", "status", "action_type", "title", "summary", "required_action", "blocking", "created_at"],
  "properties": {
    "human_action_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["OPEN", "NOTIFIED", "WAITING_FOR_OWNER", "VERIFYING", "VERIFIED", "CANCELLED", "FAILED"]},
    "action_type": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "required_action": {"type": "string", "minLength": 1},
    "blocking": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"},
    "due_at": {"type": ["string", "null"], "format": "date-time"},
    "resolved_at": {"type": ["string", "null"], "format": "date-time"},
    "resume_condition": {"type": ["string", "null"]},
    "verification_method": {"type": ["string", "null"]},
    "last_verification_error": {"type": ["string", "null"]}
  }
}
